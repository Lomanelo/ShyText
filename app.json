{
  "expo": {
    "name": "ShyText",
    "slug": "myshytext",
    "owner": "rahimrady",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.rahimrady.myshytext",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahimrady.myshytext",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.rahimrady.myshytext",
              "com.googleusercontent.apps.680911194317-g3amhmkgvie7gdmdcalkn14p46ralg1h"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to find nearby users",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to find nearby users even when in background",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to find nearby users even when in background",
        "NSLocalNetworkUsageDescription": "This app uses nearby connections to discover and connect with other devices",
        "NSBonjourServices": ["_nearby._tcp"],
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to discover and connect with nearby devices",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to discover and connect with nearby devices"
      }
    },
    "android": {
      "package": "com.rahimrady.myshytext",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.rahimrady.myshytext"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-nearby-connections",
        {
          "ios": {
            "NSLocalNetworkUsageDescription": "This app uses nearby connections to discover and connect with other devices",
            "NSBonjourServices": ["_nearby._tcp"],
            "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to discover and connect with nearby devices",
            "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to discover and connect with nearby devices"
          },
          "android": {
            "permissions": [
              "android.permission.BLUETOOTH",
              "android.permission.BLUETOOTH_ADMIN",
              "android.permission.BLUETOOTH_CONNECT",
              "android.permission.BLUETOOTH_SCAN",
              "android.permission.BLUETOOTH_ADVERTISE",
              "android.permission.ACCESS_WIFI_STATE",
              "android.permission.CHANGE_WIFI_STATE",
              "android.permission.ACCESS_FINE_LOCATION",
              "android.permission.ACCESS_COARSE_LOCATION",
              "android.permission.INTERNET"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "57b9a2ad-1680-48a9-9869-c7778a0dffc2"
      }
    }
  }
}
