{
  "expo": {
    "name": "ShyText",
    "slug": "myshytext",
    "owner": "rahimrady",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.rahimrady.myshytext",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rahimrady.myshytext",
      "buildNumber": "30",
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.rahimrady.myshytext"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "ShyText uses your location only to identify the place you're currently visiting. Your exact location is never shown to other users.",
        "NSPhotoLibraryUsageDescription": "ShyText needs access to your photos so you can upload a profile picture.",
        "NSCameraUsageDescription": "ShyText needs access to your camera so you can take a profile picture.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIDeviceFamily": [
          1
        ]
      }
    },
    "android": {
      "package": "com.rahimrady.myshytext",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FCF3E8"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": "./locales/native/en.json",
      "es": "./locales/native/es.json",
      "pt-BR": "./locales/native/pt-BR.json",
      "fr": "./locales/native/fr.json",
      "de": "./locales/native/de.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "pt-BR",
              "fr",
              "de"
            ],
            "android": [
              "en",
              "es",
              "pt-BR",
              "fr",
              "de"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShyText uses your location only to identify the place you're currently visiting. Your exact location is never shown to other users."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ShyText needs access to your photos so you can upload a profile picture.",
          "cameraPermission": "ShyText needs access to your camera so you can take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D05927",
          "sounds": [
            "./assets/sounds/notification.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flame-lit.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FCF3E8",
          "dark": {
            "image": "./assets/images/flame-lit.png",
            "backgroundColor": "#12100E"
          }
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/with-siri-check-in",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "57b9a2ad-1680-48a9-9869-c7778a0dffc2"
      }
    }
  }
}
