{
  "expo": {
    "name": "ShyText",
    "slug": "myshytext",
    "owner": "rahimrady",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.rahimrady.myshytext",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rahimrady.myshytext",
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.rahimrady.myshytext",
              "com.googleusercontent.apps.680911194317-g3amhmkgvie7gdmdcalkn14p46ralg1h"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "ShyText uses your location only to identify the place you're currently visiting. Your exact location is never shown to other users.",
        "NSPhotoLibraryUsageDescription": "ShyText needs access to your photos so you can upload a profile picture.",
        "NSCameraUsageDescription": "ShyText needs access to your camera so you can take a profile picture.",
        "UIBackgroundModes": ["remote-notification"],
        "aps-environment": "production",
        "UIDeviceFamily": [1]
      }
    },
    "android": {
      "package": "com.rahimrady.myshytext",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#5B3FD9"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShyText uses your location only to identify the place you're currently visiting. Your exact location is never shown to other users."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ShyText needs access to your photos so you can upload a profile picture.",
          "cameraPermission": "ShyText needs access to your camera so you can take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B3FD9",
          "sounds": ["./assets/sounds/notification.wav"],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "57b9a2ad-1680-48a9-9869-c7778a0dffc2"
      }
    }
  }
}
