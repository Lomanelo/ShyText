EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=myshytext.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Client URL of the Netlify Places proxy. Apple Maps keys stay on the server.
EXPO_PUBLIC_PLACES_PROXY_URL=

# Optional. Defaults to the Firebase Hosting recaptcha page.
EXPO_PUBLIC_PHONE_RECAPTCHA_URL=

# Enables demo venues and seeded ShyTexts. Leave false for a production-like development client.
EXPO_PUBLIC_DEV_MODE=false
