{
  "name": "shytext",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "eas:ios:dev": "cross-env EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --profile development --platform ios",
    "eas:ios:preview": "cross-env EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --profile preview --platform ios",
    "eas:ios:prod": "cross-env EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --profile production --platform ios",
    "eas:ios:credentials": "cross-env EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli credentials --platform ios"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@netlify/functions": "^6.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.20",
    "firebase": "^12.4.0",
    "i18next": "^26.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  }
}
