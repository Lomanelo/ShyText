rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isParticipant(ids) {
      return signedIn() && request.auth.uid in ids;
    }

    match /users/{userId} {
      // Profiles are fetched by id (get). Collection listing is denied.
      allow get: if signedIn();
      allow list: if false;

      allow create: if isSelf(userId)
        && request.resource.data.status == 'active'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;

      // Clients may update profile fields but must never change status/createdAt
      // (admins set suspended via console / Admin SDK).
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'username',
            'avatarUrl',
            'age',
            'bio',
            'stats',
            'language',
            'notificationPrefs',
            'visibilityMode',
            'expoPushToken'
          ])
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSelf(userId);

      // Owner-only facts (gender, birthday, email, city, nationality, device).
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /venues/{venueId} {
      function venueKeysOk() {
        return request.resource.data.keys().hasAll(['provider', 'providerPlaceId', 'name'])
          && request.resource.data.provider is string
          && request.resource.data.providerPlaceId is string
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120;
      }
      allow read: if signedIn();
      allow create: if signedIn() && venueKeysOk();
      // Discovery clients may refresh image/geo metadata only.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'imageUrl',
            'address',
            'category',
            'latitude',
            'longitude',
            'name'
          ])
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.providerPlaceId == resource.data.providerPlaceId;
      allow delete: if false;
    }

    match /venueHeat/{heatId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.venueId is string
        && request.resource.data.dayKey is string
        && request.resource.data.name is string
        && request.resource.data.count is number
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count', 'updatedAt', 'name', 'latitude', 'longitude']);
      allow delete: if false;
    }

    match /checkins/{checkInId} {
      function isValidCheckIn() {
        return request.resource.data.userId is string
          && request.resource.data.venueId is string
          && request.resource.data.expiresAt is number
          && request.resource.data.createdAt is number
          && (!('vibe' in request.resource.data)
            || request.resource.data.vibe == null
            || request.resource.data.vibe is string)
          && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || request.resource.data.displayName is string)
          && (!('avatarUrl' in request.resource.data)
            || request.resource.data.avatarUrl == null
            || request.resource.data.avatarUrl is string)
          && (!('age' in request.resource.data)
            || request.resource.data.age == null
            || request.resource.data.age is int || request.resource.data.age is float)
          && (!('status' in request.resource.data)
            || request.resource.data.status == null
            || (request.resource.data.status is string
              && request.resource.data.status.size() <= 40));
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == checkInId
        && isSelf(request.resource.data.userId)
        && isValidCheckIn();
      allow update: if isSelf(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && isValidCheckIn();
      allow delete: if false;
    }

    match /shytexts/{shytextId} {
      // Author always; others only while live-Shyned at the same venue (stops note scraping).
      function liveAtShytextVenue() {
        return signedIn()
          && exists(/databases/$(database)/documents/checkins/$(request.auth.uid))
          && get(/databases/$(database)/documents/checkins/$(request.auth.uid)).data.venueId
            == resource.data.venueId
          && get(/databases/$(database)/documents/checkins/$(request.auth.uid)).data.expiresAt
            > request.time.toMillis();
      }
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || liveAtShytextVenue()
      );
      allow create: if isSelf(request.resource.data.authorId)
        && request.resource.data.venueId is string
        && (
          request.resource.data.vibe is string
          || request.resource.data.intent is string
        )
        && (
          !('message' in request.resource.data)
          || request.resource.data.message == null
          || (
            request.resource.data.message is string
            && request.resource.data.message.size() <= 120
          )
        );
      allow update: if (
          (isSelf(resource.data.authorId) || isSelf(resource.data.userId))
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.venueId == resource.data.venueId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'responseCount', 'expiresAt'])
        )
        || (signedIn()
          && liveAtShytextVenue()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']));
      allow delete: if false;
    }

    match /chatRequests/{requestId} {
      function partyToRequest() {
        return signedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
        );
      }
      allow get: if signedIn() && (
        (resource == null && requestId.matches('^' + request.auth.uid + '_.+'))
        || (resource != null && partyToRequest())
      );
      allow list: if partyToRequest();
      allow create: if isSelf(request.resource.data.senderId)
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.receiverId is string
        && request.resource.data.venueId is string
        && request.resource.data.status == 'pending';
      allow update: if partyToRequest()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.venueId == resource.data.venueId
        && (
          // Accept / decline / cancel a pending request (or attach conversationId after accept).
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'conversationId'])
            && (
              (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined', 'cancelled'])
              || (resource.data.status == 'accepted'
                && request.resource.data.status == 'accepted')
            )
          )
          // Re-send after decline/cancel at the same venue (deterministic doc id).
          || (
            resource.data.status in ['declined', 'cancelled']
            && isSelf(resource.data.senderId)
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'createdAt',
                'serverCreatedAt',
                'checkInId',
                'shytextId',
                'shytextIntent',
                'venueName',
                'senderName',
                'senderAvatarUrl',
                'introMessage',
                'introKey'
              ])
          )
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function convo() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }
      function sendingOpen() {
        // Instagram-style: once a thread is active, messaging stays open (no sendUntil timer).
        return convo().status == 'active';
      }
      allow read: if isParticipant(resource.data.participantIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      // Participants may touch thread metadata only — never rewrite the pair.
      allow update: if isParticipant(resource.data.participantIds)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'lastMessage',
            'lastMessageAt',
            'lastSenderId',
            'pinnedBy',
            'deletedAt',
            'lastReadAt',
            'introMessage',
            'introMessageKey',
            'introSenderId'
          ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(convo().participantIds);
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in convo().participantIds
          && sendingOpen()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 160;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if isSelf(resource.data.reporterId);
      allow create: if isSelf(request.resource.data.reporterId)
        && request.resource.data.reason is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && (!('details' in request.resource.data)
          || request.resource.data.details == null
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 500));
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      // Missing docs have no resource.data — a plain resource.data check
      // denies the get, which broke venue preview whenever anyone else was there.
      function ownBlockDocId() {
        return signedIn() && (
          blockId.matches('^' + request.auth.uid + '_.+') ||
          blockId.matches('.+_' + request.auth.uid + '$')
        );
      }
      allow get: if ownBlockDocId() && (
        resource == null
        || resource.data.blockerId == request.auth.uid
        || resource.data.blockedId == request.auth.uid
      );
      allow list: if signedIn() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isSelf(request.resource.data.blockerId)
        && request.resource.data.blockedId is string
        && request.auth.uid != request.resource.data.blockedId
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isSelf(resource.data.blockerId);
      allow update: if false;
    }
  }
}
