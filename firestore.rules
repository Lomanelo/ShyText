rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isParticipant(ids) {
      return signedIn() && request.auth.uid in ids;
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /venueHeat/{heatId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.venueId is string
        && request.resource.data.dayKey is string
        && request.resource.data.name is string
        && request.resource.data.count is number
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count', 'updatedAt', 'name', 'latitude', 'longitude']);
      allow delete: if false;
    }

    match /checkins/{checkInId} {
      function isValidCheckIn() {
        return request.resource.data.userId is string
          && request.resource.data.venueId is string
          && request.resource.data.expiresAt is number
          && request.resource.data.createdAt is number
          && (!('vibe' in request.resource.data)
            || request.resource.data.vibe == null
            || request.resource.data.vibe is string)
          && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || request.resource.data.displayName is string)
          && (!('avatarUrl' in request.resource.data)
            || request.resource.data.avatarUrl == null
            || request.resource.data.avatarUrl is string)
          && (!('age' in request.resource.data)
            || request.resource.data.age == null
            || request.resource.data.age is int || request.resource.data.age is float)
          && (!('status' in request.resource.data)
            || request.resource.data.status == null
            || (request.resource.data.status is string
              && request.resource.data.status.size() <= 40));
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == checkInId
        && isSelf(request.resource.data.userId)
        && isValidCheckIn();
      allow update: if isSelf(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && isValidCheckIn();
      allow delete: if false;
    }

    match /shytexts/{shytextId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.authorId)
        && (
          request.resource.data.vibe is string
          || request.resource.data.intent is string
        )
        && (
          !('message' in request.resource.data)
          || request.resource.data.message == null
          || (
            request.resource.data.message is string
            && request.resource.data.message.size() <= 120
          )
        );
      allow update: if isSelf(resource.data.authorId)
        || isSelf(resource.data.userId)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']));
      allow delete: if false;
    }

    match /chatRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSelf(request.resource.data.senderId)
        && request.resource.data.senderId != request.resource.data.receiverId;
      allow update: if signedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(resource.data.participantIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant(resource.data.participantIds);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 160;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if isSelf(resource.data.reporterId);
      allow create: if isSelf(request.resource.data.reporterId);
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isSelf(request.resource.data.blockerId);
      allow delete: if isSelf(resource.data.blockerId);
      allow update: if false;
    }
  }
}
