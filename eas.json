{
  "cli": {
    "version": ">= 16.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_MODE": "true",
        "EXPO_PUBLIC_PLACES_PROXY_URL": "https://shytextapi.netlify.app/api/places",
        "EXPO_PUBLIC_API_BASE": "https://shytextapi.netlify.app",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "auth.shytext.com",
        "EXPO_PUBLIC_PHONE_RECAPTCHA_URL": "https://auth.shytext.com/phone-recaptcha.html"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEV_MODE": "false",
        "EXPO_PUBLIC_PLACES_PROXY_URL": "https://shytextapi.netlify.app/api/places",
        "EXPO_PUBLIC_API_BASE": "https://shytextapi.netlify.app",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "auth.shytext.com",
        "EXPO_PUBLIC_PHONE_RECAPTCHA_URL": "https://auth.shytext.com/phone-recaptcha.html"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "voxetik@gmail.com",
        "ascAppId": "6745570237",
        "appleTeamId": "5ZFG6BQDFL"
      }
    }
  }
}
